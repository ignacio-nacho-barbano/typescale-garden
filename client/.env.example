# Cloudflare Pages Environment Variables
# Copy to .env.local or set in Cloudflare Dashboard

# Auth0 Configuration
PUB_AUTH_DOMAIN=https://your-auth0-domain.auth0.com/
PUB_API_URL=
PUB_CLIENT_ORIGIN=http://localhost:5173

# App Configuration
PUB_APP_ENV=dev

# LOCAL DEVELOPMENT ONLY
# (For local SQLite databases, not needed on Cloudflare Pages)
DATABASE_URL=file:./.local/dev.db
