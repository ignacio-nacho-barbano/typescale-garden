{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "typescale-garden-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-01",
	// nodejs_compat (with a 2024-09-23+ date) gives us the node:crypto, node:net
	// and node:tls surface that Express and the MongoDB driver need on Workers.
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	// Non-sensitive, client-public config. Read via process.env under nodejs_compat.
	// Secrets (DB_STRING, JWT_SECRET, SESSION_SECRET) are NOT here — set them with
	// `wrangler secret put <NAME>` (prod) or in .dev.vars (local).
	"vars": {
		"APP_PORT": "3000",
		"PUB_APP_ENV": "prod",
		"PUB_CLIENT_ORIGIN": "https://typescalegarden.uy",
		"PUB_API_URL": "https://api.typescalegarden.uy",
		"PUB_AUTH_CLIENT_ID": "Ujv0yJQq66VJAwNquvaJuaAX0hAUoiS0",
		"PUB_AUTH_DOMAIN": "https://typescale-garden-prod.us.auth0.com",
		"PUB_FEATURE_FLAGS": "load-save"
	}
}
