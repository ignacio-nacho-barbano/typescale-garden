{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "typescale-garden-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-01",
	// nodejs_compat (with a 2024-09-23+ date) gives us the node: surface that
	// Express needs on Workers.
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	// NOTE: do NOT pin `dev.port` to 3000 to match APP_PORT / PUB_API_URL. Under
	// nodejs_compat the `app.listen(APP_PORT)` in src/index.ts binds a *real* socket, so
	// workerd already owns 127.0.0.1:3000 by the time wrangler tries to open its own dev
	// server there, and startup dies with "Address already in use". `wrangler dev` has to
	// stay on a different port (8787 by default); point PUB_API_URL at that instead.
	// Typescale storage. Replaced MongoDB Atlas — see migrations/ for the schema
	// and scripts/export-atlas.mjs for the one-off data transfer.
	//
	// `preview_database_id` is what `wrangler dev --remote` talks to; plain
	// `wrangler dev` uses a local SQLite file under .wrangler/state instead.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "typescale-garden-prod",
			"database_id": "51da3741-1647-4a65-b457-6809b31989c4",
			"preview_database_id": "4437243e-3261-4e82-95e1-f8a6cdf014d2",
			"migrations_dir": "migrations"
		}
	],
	// The Google Fonts catalogue snapshot, refreshed by the Cron Trigger below and
	// served as GET /api/fonts. Replaced the committed client/static/fonts-data.json,
	// which could only be updated by a Pages rebuild. See src/fonts/snapshot.ts.
	//
	// KV and not D1: the payload is ~1.9 MB and growing (1951 families in July 2026),
	// against a 2,000,000-byte ceiling on a D1 row and 25 MiB on a KV value.
	"kv_namespaces": [
		{
			"binding": "FONTS",
			"id": "0ac3373f7cf8459c8dffef715765cc46",
			"preview_id": "00d48d5a982747579315b0743752d6bb"
		}
	],
	// Daily refresh. 04:17 UTC — off the hour to avoid the cron thundering herd, and
	// outside Montevideo waking hours.
	//
	// NOTE: `wrangler deploy` only PUTs the schedule when `crons` is set, so deleting
	// this block does NOT remove the trigger — do that in the dashboard.
	// Locally, `wrangler dev` does not fire crons; trigger one by hand with
	// `curl "http://localhost:8787/cdn-cgi/handler/scheduled"`.
	"triggers": {
		"crons": ["17 4 * * *"]
	},
	// Non-sensitive, client-public config. Read via process.env under nodejs_compat.
	// Secrets (JWT_SECRET, SESSION_SECRET) are NOT here — set them with
	// `wrangler secret put <NAME>` (prod) or in .dev.vars (local).
	"vars": {
		// Sentry's ingest endpoint for this Worker — see src/sentry.ts. A DSN is a public
		// identifier that only grants "write an event", so it belongs here rather than
		// behind `wrangler secret put`. The `de` in the host is the org's region; it is
		// part of the DSN, not something to normalise away.
		//
		// Setting this to "" is a supported state and means "report nothing":
		// `SENTRY_ENABLED` in src/secrets.ts is a truthiness check on it.
		"SENTRY_DSN": "https://d67d38563f6359c0766c81e5126ad044@o4511689468608512.ingest.de.sentry.io/4511809570144336",
		"APP_PORT": "3000",
		"PUB_APP_ENV": "prod",
		"PUB_CLIENT_ORIGIN": "https://typescalegarden.uy",
		"PUB_API_URL": "https://api.typescalegarden.uy",
		"PUB_AUTH_CLIENT_ID": "Ujv0yJQq66VJAwNquvaJuaAX0hAUoiS0",
		"PUB_AUTH_DOMAIN": "https://typescale-garden-prod.us.auth0.com",
		"PUB_FEATURE_FLAGS": "load-save"
	}
}
