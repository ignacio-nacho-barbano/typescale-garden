{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "typescale-garden-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-01",
	// nodejs_compat (with a 2024-09-23+ date) gives us the node: surface that
	// Express needs on Workers.
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	// Typescale storage. Replaced MongoDB Atlas — see migrations/ for the schema
	// and scripts/export-atlas.mjs for the one-off data transfer.
	//
	// `preview_database_id` is what `wrangler dev --remote` talks to; plain
	// `wrangler dev` uses a local SQLite file under .wrangler/state instead.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "typescale-garden-prod",
			"database_id": "51da3741-1647-4a65-b457-6809b31989c4",
			"preview_database_id": "4437243e-3261-4e82-95e1-f8a6cdf014d2",
			"migrations_dir": "migrations"
		}
	],
	// Non-sensitive, client-public config. Read via process.env under nodejs_compat.
	// Secrets (JWT_SECRET, SESSION_SECRET) are NOT here — set them with
	// `wrangler secret put <NAME>` (prod) or in .dev.vars (local).
	"vars": {
		"APP_PORT": "3000",
		"PUB_APP_ENV": "prod",
		"PUB_CLIENT_ORIGIN": "https://typescalegarden.uy",
		"PUB_API_URL": "https://api.typescalegarden.uy",
		"PUB_AUTH_CLIENT_ID": "Ujv0yJQq66VJAwNquvaJuaAX0hAUoiS0",
		"PUB_AUTH_DOMAIN": "https://typescale-garden-prod.us.auth0.com",
		"PUB_FEATURE_FLAGS": "load-save"
	}
}
