{
	"name": "server",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"build": "tsc --noEmit && wrangler deploy --dry-run",
		"dev": "wrangler dev",
		"deploy": "wrangler deploy",
		"cf-typegen": "wrangler types",
		"db:migrate:local": "wrangler d1 migrations apply typescale-garden-prod --local",
		"db:migrate:preview": "wrangler d1 migrations apply typescale-garden-prod --preview --remote",
		"db:migrate:remote": "wrangler d1 migrations apply typescale-garden-prod --remote",
		"db:import:local": "wrangler d1 execute typescale-garden-prod --local --file=./scripts/atlas-import.sql",
		"db:import:preview": "wrangler d1 execute typescale-garden-prod --preview --remote --file=./scripts/atlas-import.sql",
		"db:import:remote": "wrangler d1 execute typescale-garden-prod --remote --file=./scripts/atlas-import.sql",
		"db:export:atlas": "node --env-file=./.dev.vars ./scripts/export-atlas.mjs"
	},
	"dependencies": {
		"cookie-parser": "~1.4.4",
		"cors": "^2.8.5",
		"debug": "~2.6.9",
		"express": "^4.18.2",
		"express-oauth2-jwt-bearer": "^1.6.0",
		"express-openid-connect": "^2.17.1",
		"helmet": "^7.1.0",
		"jsonwebtoken": "^9.0.2",
		"jwks-rsa": "^3.1.0",
		"morgan": "~1.9.1",
		"rollbar": "^2.26.3",
		"typescript": "^5.3.3"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260714.1",
		"wrangler": "^4.112.0",
		"mongodb": "^6.15.0",
		"@types/cookie-parser": "^1.4.6",
		"@types/cors": "^2.8.17",
		"@types/express": "^4.17.21",
		"@types/jsonwebtoken": "^9.0.5",
		"@types/morgan": "^1.9.9",
		"@types/node": "^20.11.16",
		"dotenv-cli": "^7.3.0",
		"nodemon": "^3.0.3",
		"ts-node": "^10.9.2"
	}
}
