{
	"include": ["./src"],
	"compileOnSave": true,
	"compilerOptions": {
		"outDir": "dist",
		// TS 7 no longer infers the common source directory. This has to stay `./src` so the emit
		// keeps landing at dist/functions/… — the path `create:fonts-file` and `@services/*` expect.
		"rootDir": "./src",
		"declaration": true,
		"declarationMap": true,
		"module": "NodeNext",
		// These scripts run under plain Node. TS 7 no longer includes @types packages implicitly,
		// so `node` has to be named here for `fs` and `process` to resolve.
		"types": ["node"]
	}
}
