	"dependencies": {
		"core": "*"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@figma/eslint-plugin-figma-plugins": "^0.14.0",
		"@figma/plugin-typings": "^1.88.0",
		"esbuild": "^0.28.1",
		"eslint": "^10.8.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.65.0"
	}
}