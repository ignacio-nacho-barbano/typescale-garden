{
	"name": "plugin",
	"version": "1.1.2",
	"private": true,
	"description": "An import tool for typescale-garden",
	"main": "code.js",
	"scripts": {
		"build": "node ./build.mjs",
		"check": "tsc -p ./tsconfig.json --noEmit",
		"check:watch": "tsc -p ./tsconfig.json --noEmit --watch",
