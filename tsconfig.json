{
	// TS 7 removed `baseUrl`; `paths` values are resolved relative to this file and must
	// therefore be written relatively. Nothing imports through this alias yet — it is kept
	// so `types/` stays reachable if something starts to.
	"compilerOptions": {
		"paths": { "@tsg-types": ["./types/index"] },
		// TS 7 no longer pulls in every package it can find under a type root, so these roots
		// only serve to resolve the names each package lists in its own `types`.
		"typeRoots": ["./node_modules/@types", "./node_modules/@figma"]
	}
}
